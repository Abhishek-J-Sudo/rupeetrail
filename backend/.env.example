# Copy this file to backend/.env and fill in what you need.
# Everything works without it; AI features stay hidden until a key is set.

# AI is optional: bring your own key. Easiest is Settings → AI in the app, which writes these.
# AI_PROVIDER=none | deepseek | openai | anthropic | ollama
AI_PROVIDER=none
# DEEPSEEK_API_KEY=      (https://platform.deepseek.com)
# OPENAI_API_KEY=        (https://platform.openai.com)
# ANTHROPIC_API_KEY=     (https://console.anthropic.com)
# Ollama runs on this computer and needs no key (https://ollama.com)
# Optional per provider: <PROVIDER>_MODEL=..., <PROVIDER>_BASE_URL=...
# e.g. OLLAMA_MODEL=llama3.1, OLLAMA_BASE_URL=http://localhost:11434

# Where RupeeTrail keeps your data (database, backups, settings, kept statements).
# Default: the data/ folder next to the app. A relative path counts from the app folder;
# ~ means your home folder. Move the existing folder there yourself before changing this.
# RUPEETRAIL_DATA_DIR=~/RupeeTrail
